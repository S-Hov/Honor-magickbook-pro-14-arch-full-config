// Быстрые, мягкие анимации / Fast, soft animations
animations {
    workspace-switch {
        spring damping-ratio=0.92 stiffness=850 epsilon=0.0001
    }
    window-open {
        duration-ms 160
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 140
        curve "ease-out-cubic"
    }
    horizontal-view-movement {
        spring damping-ratio=0.92 stiffness=750 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=0.90 stiffness=700 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.70 stiffness=1000 epsilon=0.001
    }
    exit-confirmation-open-close {
        spring damping-ratio=0.75 stiffness=600 epsilon=0.01
    }
    screenshot-ui-open {
        duration-ms 180
        curve "ease-out-quad"
    }
    overview-open-close {
        spring damping-ratio=0.92 stiffness=750 epsilon=0.0001
    }
    recent-windows-close {
        duration-ms 130
        curve "ease-out-cubic"
    }
}
