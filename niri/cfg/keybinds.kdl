// Единая схема: Mod фокус, Shift перенос, Ctrl служебное
// Unified scheme: Mod focus, Shift move, Ctrl secondary action
binds {
    // Локальная диктовка на NPU: повторное нажатие завершает запись.
    Mod+Ctrl+R repeat=false hotkey-overlay-title="Voice input / Голосовой ввод" { spawn "@@HOME@@/.local/bin/honor-dictation" "toggle"; }
    Mod+Ctrl+Escape repeat=false hotkey-overlay-title="Cancel voice input / Отменить диктовку" { spawn "@@HOME@@/.local/bin/honor-dictation" "cancel"; }

    // Приложения / Applications
    Mod+Return hotkey-overlay-title="Terminal / Терминал: Kitty" { spawn "kitty"; }
    Mod+D hotkey-overlay-title="App launcher / Меню приложений" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+B hotkey-overlay-title="Browser / Браузер: Brave" { spawn "brave" "--ozone-platform=wayland"; }
    Mod+E hotkey-overlay-title="Files / Файлы: Nautilus" { spawn "nautilus"; }
    Mod+M hotkey-overlay-title="Music / Музыка: cliamp" { spawn "kitty" "--class" "cliamp" "--title" "cliamp" "cliamp"; }
    Mod+V hotkey-overlay-title="Clipboard / Буфер обмена" { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }
    Mod+Alt+L hotkey-overlay-title="Lock / Блокировка" allow-inhibiting=false { spawn "noctalia" "msg" "session" "lock"; }


    // Фокус окон / Window focus
    Mod+Q { close-window; }
    Mod+Left  { focus-column-left; }
    Mod+H     { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+L     { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+J     { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+K     { focus-window-down; }
    Mod+Home  { focus-column-first; }
    Mod+End   { focus-column-last; }

    // Перемещение окон / Window movement
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+H  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+J    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+K  { move-window-down; }
    Mod+Shift+Home  { move-column-to-first; }
    Mod+Shift+End   { move-column-to-last; }

    // Размер и расположение / Size and placement
    Mod+C       { center-column; }
    Mod+Ctrl+C  { center-visible-columns; }
    Mod+F       { fullscreen-window; }
    // Вся ширина монитора независимо от соседних колонок; повтор возвращает размер.
    Mod+Ctrl+F repeat=false { maximize-column; }
    Mod+T       { toggle-window-floating; }
    Mod+W       { toggle-column-tabbed-display; }
    Mod+R       { switch-preset-column-width; }
    Mod+Minus       { set-column-width "-5%"; }
    Mod+Equal       { set-column-width "+5%"; }
    Mod+Shift+Minus { set-window-height "-5%"; }
    Mod+Shift+Equal { set-window-height "+5%"; }

    // Рабочие столы: Ctrl+Up/Down — соседний / Workspaces: adjacent
    Mod+Ctrl+Up   { focus-workspace-up; }
    Mod+Ctrl+J   { focus-workspace-up; }
    Mod+Ctrl+Down { focus-workspace-down; }
    Mod+Ctrl+K { focus-workspace-down; }
    Mod+Ctrl+Shift+Up   { move-column-to-workspace-up; }
    Mod+Ctrl+Shift+J   { move-column-to-workspace-up; }
    Mod+Ctrl+Shift+Down { move-column-to-workspace-down; }
    Mod+Ctrl+Shift+K { move-column-to-workspace-down; }
    Mod+Tab { focus-workspace-previous; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // Мониторы / Monitors
    Mod+Ctrl+Left  { focus-monitor-left; }
    Mod+Ctrl+H  { focus-monitor-left; }
    Mod+Ctrl+Right { focus-monitor-right; }
    Mod+Ctrl+L { focus-monitor-right; }
    Mod+Ctrl+Shift+Left  { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+H  { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+Right { move-column-to-monitor-right; }
    Mod+Ctrl+Shift+L { move-column-to-monitor-right; }

    // Колесо с Mod листает столы / Mod+wheel switches workspaces
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }

    // Обзор, справка и безопасность / Overview, help and safety
    Mod+O repeat=false { toggle-overview; }
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+P { power-off-monitors; }
    Mod+Shift+E { quit; }

    // Скриншоты / Screenshots
    Print       { screenshot; }
    Shift+Print { screenshot-screen; }
    Ctrl+Print  { screenshot-window; }

    // Звук через Noctalia v5 / Audio via Noctalia v5
    XF86AudioRaiseVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute repeat=false allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute repeat=false allow-when-locked=true { spawn "noctalia" "msg" "mic-mute"; }

    XF86MonBrightnessUp allow-when-locked=true { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "noctalia" "msg" "brightness-down"; }
    XF86AudioPlay { spawn "playerctl" "play-pause"; }
    XF86AudioNext { spawn "playerctl" "next"; }
    XF86AudioPrev { spawn "playerctl" "previous"; }

    // Переключение раскладки по Meta + Space (Win + Space)
    Mod+Space { switch-layout "next"; }
}
